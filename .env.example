# ═══════════════════════════════════════════════════════════════════════════
# RDO ONE — deployment environment.
#
#   cp .env.example .env    then fill in every value marked REQUIRED.
#
# This single file feeds three different things, and the difference matters:
#
#   1. Compose interpolation  — ${DOMAIN}, ${REDIS_PASSWORD}, ${IMAGE_TAG}
#   2. Build ARGs             — NEXT_PUBLIC_*, frozen into the browser bundle
#   3. Backend runtime env    — everything else, via `env_file: .env`
#
# NEVER COMMIT THIS FILE FILLED IN. Keep a copy OFF THE BOX — a password
# manager is enough. A Redis backup without AGENT_KEY_ENCRYPTION_SECRET is
# unrecoverable ciphertext: the keys are there and nothing can read them.
# ═══════════════════════════════════════════════════════════════════════════

# ── Deployment ─────────────────────────────────────────────────────────────

# REQUIRED. Public hostname, apex only, no scheme and no trailing slash.
# Drives the nginx server_name, the TLS certificate, and the backend's
# ALLOWED_ORIGINS (derived in docker-compose.yml as https://$DOMAIN plus www).
# DNS A records for both $DOMAIN and www.$DOMAIN must already point at this
# VPS before running deploy/init-letsencrypt.sh, or issuance fails.
DOMAIN=rdoone.com

# REQUIRED for TLS issuance. Let's Encrypt sends expiry warnings here.
CERTBOT_EMAIL=you@example.com

# Image tag for this deployment. deploy/deploy.sh sets this to the short git
# SHA automatically; `latest` alone gives you no rollback story.
IMAGE_TAG=latest

# ── Redis ──────────────────────────────────────────────────────────────────

# REQUIRED. Generate once:  openssl rand -hex 32
# Redis is internal-only (no published port), so this is defence in depth
# rather than the primary control — but it is what stops any other container
# on the same network reading every user's encrypted agent key.
# docker-compose.yml builds REDIS_URL from this; do not set REDIS_URL here.
REDIS_PASSWORD=

# ── Frontend BUILD-TIME values ─────────────────────────────────────────────
# Inlined into the client bundle by `next build`. Changing either one needs a
# REBUILD (deploy/deploy.sh does this); a restart will not pick it up.

# REQUIRED. Public WebSocket origin of the backend relay. Must be the real
# public host over wss:// — nginx proxies /ws to the backend.
# A localhost value fails the build on purpose (next.config.js): it would
# otherwise ship a bundle where every visitor's browser dials its own machine
# and the price stream silently never connects.
NEXT_PUBLIC_HL_WS_URL=wss://rdoone.com/ws

# Optional. WalletConnect Cloud project ID (free, cloud.walletconnect.com).
# Empty is a supported configuration: the WalletConnect entry is hidden from
# the wallet chooser and injected wallets (MetaMask, Rabby, Phantom) still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Backend runtime ────────────────────────────────────────────────────────
# Passed to the backend container via env_file. NODE_ENV, PORT, REDIS_URL and
# ALLOWED_ORIGINS are set in docker-compose.yml — do not duplicate them here.

# REQUIRED for EXTRA mode. Encrypts each user's Aster agent key and V1 API
# credentials at rest in Redis (src/lib/secret-box.ts). Generate ONCE, before
# the first user:
#
#     openssl rand -hex 32
#
# Rotating it invalidates every stored agent key: users re-approve, one
# signature each. That never risks funds — agents are registered
# canWithdraw: false — but it is a visible interruption for everyone.
# THIS IS THE ONE VALUE THAT MUST EXIST OFF THIS BOX.
AGENT_KEY_ENCRYPTION_SECRET=

# Optional. 1inch API key (portal.1inch.dev). Without it the Swap tab's routes
# return 503; nothing else is affected.
ONEINCH_API_KEY=

# Optional but strongly recommended in production. LI.FI API key
# (https://portal.li.fi). Unauthenticated limits are per-IP, and every user
# shares this VPS's single IP: 75 /quote calls per TWO HOURS between all of
# them. The Transfer page fires a debounced quote as the amount is typed, so a
# handful of users exhaust it — and the failure surfaces as "no route found"
# rather than as a rate limit. A key raises it ~24x, for $0.
LIFI_API_KEY=

# Optional. Private key of one shared Aster Pro (V3) agent, used only for the
# unauthenticated GET /aster-leverage-brackets. Unset means the leverage slider
# keeps flat defaults instead of real per-symbol caps. Trading is unaffected:
# every account-specific signed route uses the caller's own per-user agent.
ASTER_SIGNER_PRIVATE_KEY=

# ── Observability ──────────────────────────────────────────────────────────
# There is no error-tracking service and no agent: everything the backend knows
# goes to stdout as pino JSON, which Docker captures and rotates (10MB × 3, set
# in docker-compose.yml). `docker compose logs backend` is the tool.
#
# The money paths — withdrawals, order placements, TP/SL arming and placement —
# log at `info` through a dedicated child logger even though production's level
# is `warn`, so they are never the thing the level silences. They are tagged
# `"audit":"money"`; see deploy/RUNBOOK.md § Observability for the queries.

# Request-BODY logging. LEAVE THIS OFF. The body of /aster-withdraw is two
# signatures that together are a replayable withdrawal; /aster-session's is the
# signature that mints a session cookie. Even set to `true` those routes' bodies
# are still dropped — this only ever adds the harmless ones — but it is a
# debugging switch for a box you are actively watching, not a setting.
LOG_REQUEST_BODIES=false

# ── Limits ─────────────────────────────────────────────────────────────────
# Per client IP, which only works because nginx sets X-Forwarded-For and the
# backend sets trustProxy: true. Both halves are required.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# WebSocket relay backstops, per endpoint (/ws and /aster-stream). Generous on
# purpose: someone with five tabs open is not an attacker. This exists to stop
# the VPS being used as a free unbounded Hyperliquid relay.
WS_MAX_CONNECTIONS_PER_IP=25
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=100
