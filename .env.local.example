# ═══════════════════════════════════════════════════════════════════════════
# RDO ONE — LOCAL Docker testing environment.
#
#   cp .env.local.example .env.local     then fill in the two REQUIRED values
#
# This is the local counterpart to .env.example. It feeds the same three
# consumers, via `--env-file .env.local`:
#
#   1. Compose interpolation  — ${REDIS_PASSWORD}, ${LOCAL_HOST}
#   2. Build ARGs             — NEXT_PUBLIC_*, frozen into the browser bundle
#   3. Backend runtime env    — everything else, via `env_file: .env.local`
#
# Nothing here is production. Generate throwaway secrets and do not reuse the
# production AGENT_KEY_ENCRYPTION_SECRET: this file sits unencrypted in a
# working copy, and that one value decrypts every stored user agent key.
# ═══════════════════════════════════════════════════════════════════════════

# ── Local host ─────────────────────────────────────────────────────────────
# The hostname you open the app on. It CANNOT be localhost or 127.0.0.1:
# NEXT_PUBLIC_HL_WS_URL is inlined into the browser bundle at build time and
# next.config.js rejects loopback hostnames there, because in a shipped bundle
# they point at the visitor's own machine.
#
# rdo.localtest.me is a public wildcard DNS record resolving to 127.0.0.1 —
# no /etc/hosts entry needed, but it does need working DNS. Offline, add
#     127.0.0.1  rdo.local
# to /etc/hosts and set LOCAL_HOST=rdo.local here, then rebuild.
#
# Changing this requires `up --build`, not `up`.
LOCAL_HOST=rdo.localtest.me

# ── Redis ──────────────────────────────────────────────────────────────────
# REQUIRED. Any value works locally:  openssl rand -hex 32
# Compose builds REDIS_URL from it; do not set REDIS_URL here.
REDIS_PASSWORD=

# ── Backend runtime ────────────────────────────────────────────────────────
# NODE_ENV, PORT, REDIS_URL, ALLOWED_ORIGINS and RELEASE are set in
# docker-compose.local.yml — do not duplicate them here.

# REQUIRED for EXTRA mode (Aster agent keys, V1 API credentials).
# Generate a THROWAWAY one:  openssl rand -hex 32
# Changing it invalidates every agent key stored in the local Redis volume;
# locally that just means approving again.
AGENT_KEY_ENCRYPTION_SECRET=

# The Docker stack runs NODE_ENV=production, which pins the log level to
# `warn` — that is right on a VPS and useless on a laptop, so override it
# here. `debug` if you want ioredis and route internals too.
LOG_LEVEL=info

# Request-BODY logging. Safe to flip ON locally with your own test wallet, and
# useful for debugging Aster payloads. The money routes' bodies are dropped
# regardless (src/plugins/request-log.ts) — /aster-withdraw's body is a live
# replayable withdrawal, so it is never logged at any setting.
LOG_REQUEST_BODIES=false

# ── Optional API keys ──────────────────────────────────────────────────────
# All optional. Each feature 503s or falls back when its key is missing;
# nothing else breaks, so leave them empty until you need to test that path.

# 1inch (portal.1inch.dev) — the Swap tab's routes 503 without it.
ONEINCH_API_KEY=

# LI.FI (portal.li.fi) — unauthenticated is 75 /quote calls per 2h per IP.
# That is plenty for one laptop; a key only matters on the shared VPS.
LIFI_API_KEY=

# Private key of an Aster Pro (V3) agent, used ONLY for the unauthenticated
# GET /aster-leverage-brackets. Unset means the leverage slider shows flat
# defaults. Trading is unaffected — signed routes use the caller's own agent.
ASTER_SIGNER_PRIVATE_KEY=

# WalletConnect Cloud project ID. Empty is supported: the WalletConnect entry
# is hidden and injected wallets (MetaMask, Rabby, Phantom) still work.
# BUILD-TIME — changing it requires `up --build`.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Limits ─────────────────────────────────────────────────────────────────
# Raised well above production's 200/min: without nginx in front, every
# request from your browser arrives from the same Docker-internal IP, and a
# page load fires a lot of them.
RATE_LIMIT_MAX=2000
RATE_LIMIT_WINDOW_MS=60000

WS_MAX_CONNECTIONS_PER_IP=50
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=200
