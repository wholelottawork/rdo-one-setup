PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins. Set this to the real
# domain(s) in production and never ship it empty: src/plugins/cors.ts treats an
# empty list as "allow any origin", which is convenient in dev and wrong in
# prod. It barely matters today — the browser reaches this backend through
# Next's same-origin rewrite, so CORS never applies — but it is the defence in
# depth that makes a future direct-to-backend setup safe by default.
ALLOWED_ORIGINS=https://rdoone.com,https://www.rdoone.com

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Optional. LI.FI API key (free, from the Partner Portal at
# https://portal.li.fi — see https://docs.li.fi/api-reference/rate-limits).
# LI.FI works without one, but unauthenticated limits are per-IP and every user
# of this backend shares the VPS's single IP: 75 /quote calls per TWO HOURS
# between all of them. The Transfer page fires a debounced quote as the amount
# is typed, so a handful of users exhausts that and the failure surfaces as
# "no route found" rather than as a rate limit. A key raises it to 100 per
# minute — roughly 24x — for $0. Leave unset in dev; set it in production.
LIFI_API_KEY=your_key_here

# Optional, and NOT a secret. The Partner Portal integration string that owns
# LIFI_API_KEY (Portal -> Integrations, the monospace id under the name).
# src/routes/market-data.ts forces it onto every LI.FI request as
# `integrator`; without it the calls are unattributed and Portal analytics
# stay empty. Harmless to leave unset.
LIFI_INTEGRATOR=

# REQUIRED for EXTRA mode. Secret used to encrypt each user's per-user Aster
# agent key — and their Aster V1 API credentials — at rest in Redis (see
# src/lib/secret-box.ts). Without it no agent can be minted or read, so every
# /aster-signed/* route, /aster-agent-address and the TP/SL watcher fail.
#
# Generate ONCE, before the first user, and keep a copy off the VPS (a password
# manager is enough — it is a few hundred bytes):
#
#     openssl rand -hex 32
#
# Rotating it invalidates every stored agent key and API credential: users
# re-approve, which costs one signature each and never risks funds, because
# agents are registered canWithdraw: false. NEVER commit it.
AGENT_KEY_ENCRYPTION_SECRET=your_random_secret_here

# Optional. Private key of a single shared Aster Pro (V3) agent, used for
# exactly one call: the unauthenticated GET /aster-leverage-brackets, which
# fetches exchange-wide leverage caps. When unset the frontend swallows the
# error and the leverage slider keeps its flat default instead of real
# per-symbol caps. Trading is NOT affected — every account-specific signed
# route uses the caller's own per-user agent, not this key.
# Create the agent at asterdex.com -> API Wallet -> "Pro API" tab.
# NEVER commit the private key.
ASTER_SIGNER_PRIVATE_KEY=your_agent_private_key_here

# ── Observability ──────────────────────────────────────────────────────────

# Optional. Stamped on the backend's boot log line so a log file can be pinned
# to the code that produced it. In Docker this is set from IMAGE_TAG (the short
# git SHA) automatically by docker-compose.yml — set it by hand only when
# running outside Compose.
RELEASE=

# Request-BODY logging. Leave it OFF. Fastify logs request metadata and never
# bodies, which is the correct default: on these routes the body IS the
# credential. /aster-withdraw carries two EIP-712 signatures which together are
# a withdrawal anyone who reads the log can replay until the nonce ages out
# (~2 minutes), and /aster-session's body is the signature that mints a session
# cookie.
#
# Setting this to `true` logs bodies for DEBUGGING, on a box you are watching,
# temporarily. Even then the money routes' bodies are dropped rather than
# logged (src/plugins/request-log.ts) and everything else is run through the
# redactor in src/lib/scrub.ts. The backend logs a warning at boot whenever it
# is on, so it cannot be left enabled unnoticed.
LOG_REQUEST_BODIES=false

# Rate limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# WebSocket relay caps (per endpoint: /ws and /aster-stream). Backstops against
# the VPS being used as a free relay — not a quota, keep them generous.
WS_MAX_CONNECTIONS_PER_IP=25
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=100
