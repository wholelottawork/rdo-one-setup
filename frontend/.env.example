# ---------------------------------------------------------------------------
# BUILD-TIME variables (NEXT_PUBLIC_*)
#
# Next inlines every NEXT_PUBLIC_* value into the client bundle when `next
# build` runs. They are NOT read at runtime — setting them in a container's
# `environment:` block after the image is built does nothing. In Docker they
# must be passed as build `ARG`s (see the root compose file / task 10).
# ---------------------------------------------------------------------------

# WebSocket URL of the backend's Hyperliquid relay (backend/src/ws/relay.ts).
# Used by lib/trading.ts. The dev default is ws://localhost:3001/ws.
#
# MISSING IN A PRODUCTION BUILD -> the build fails on purpose (next.config.js).
# If that guard were bypassed, the bundle would ship pointing at the *user's*
# own machine: no price stream, a chart that never ticks, and no error anywhere
# that names the cause.
NEXT_PUBLIC_HL_WS_URL=wss://your-domain.example/ws

# WalletConnect Cloud project ID (free at cloud.walletconnect.com).
# Used by lib/wallet.tsx.
#
# MISSING -> supported configuration. The "WalletConnect (mobile)" entry is
# hidden from the wallet chooser; injected wallets (MetaMask, Rabby, Phantom,
# Coinbase) keep working. The build is NOT failed for this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# SERVER/BUILD variable
#
# Used to generate Next's rewrite table. In development it is read when the
# server starts; a production build serializes it, so Docker passes it as both
# a build ARG and a runtime environment variable.
# ---------------------------------------------------------------------------

# Origin of the Fastify backend that every rewrite in next.config.js targets
# (Redis caching, rate limiting, Aster signed-endpoint auth).
#
# MISSING -> defaults to http://localhost:3001. Correct for local dev; in
# Docker it must name the backend service (e.g. http://backend:3001) or every
# proxied route 502s.
BACKEND_URL=http://localhost:3001
