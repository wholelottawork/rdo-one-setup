# ═══════════════════════════════════════════════════════════════════════════
# RDO ONE — nginx front door.
#
# Rendered from this template by the nginx image's entrypoint, which
# substitutes ONLY ${DOMAIN} (NGINX_ENVSUBST_FILTER in docker-compose.yml).
# Every other $variable below is an nginx runtime variable and must survive
# untouched — if $host or $remote_addr ever come out blank, that filter is
# the first thing to check.
#
# The filename matters. It renders to /etc/nginx/conf.d/default.conf, which
# DELIBERATELY overwrites the stock config shipped in the nginx image. That
# file defines its own catch-all server on port 80; leaving it in place makes
# it the default server for any request whose Host does not match $DOMAIN,
# which silently swallows those requests into an nginx welcome page instead
# of this config. Renaming this template re-introduces that bug.
# ═══════════════════════════════════════════════════════════════════════════

# Upstreams. Named so a proxy_pass typo fails at config-test time.
upstream rdo_backend  { server backend:3001;  keepalive 32; }
upstream rdo_frontend { server frontend:3002; keepalive 32; }

# WebSocket upgrade handling. `Connection` is hop-by-hop: it must be rewritten
# per-request, and it must be "close" for normal requests — a hardcoded
# "upgrade" on plain HTTP breaks keepalive.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

gzip              on;
gzip_vary         on;
gzip_proxied      any;
gzip_comp_level   6;
gzip_min_length   1024;
gzip_types
  text/plain text/css text/xml text/javascript
  application/javascript application/json application/xml
  application/rss+xml image/svg+xml;

# ───────────────────────────────────────────────────────────────────────────
# Port 80 — ACME challenge, then redirect everything else to HTTPS.
# ───────────────────────────────────────────────────────────────────────────
server {
  listen      80;
  listen      [::]:80;
  server_name ${DOMAIN} www.${DOMAIN};

  # Must stay on plain HTTP and must NOT be redirected: this is how certbot
  # proves control of the domain, both for first issuance and every renewal.
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ───────────────────────────────────────────────────────────────────────────
# www → apex, so there is exactly one canonical origin. The backend's
# ALLOWED_ORIGINS lists both, but cookies (the Aster trading session) are set
# per-host and would not follow a user between the two.
# ───────────────────────────────────────────────────────────────────────────
server {
  listen              443 ssl;
  listen              [::]:443 ssl;
  http2               on;
  server_name         www.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

  return 301 https://${DOMAIN}$request_uri;
}

# ───────────────────────────────────────────────────────────────────────────
# Main site.
# ───────────────────────────────────────────────────────────────────────────
server {
  listen              443 ssl;
  listen              [::]:443 ssl;
  http2               on;
  server_name         ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

  ssl_protocols             TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache         shared:SSL:10m;
  ssl_session_timeout       1d;
  ssl_session_tickets       off;

  # ── Beta access gate ─────────────────────────────────────────────────────
  # Currently OPEN: anyone who knows the hostname can use the app.
  #
  # Be clear-eyed about what "we just won't publish the URL" buys you: nothing.
  # Every certificate certbot issues is published to public Certificate
  # Transparency logs within minutes and is searchable by anyone at crt.sh.
  # An unlisted hostname is not an access control.
  #
  # To actually restrict the beta, create the password file:
  #
  #     docker run --rm -it httpd:alpine htpasswd -Bc /tmp/h user \
  #       && docker cp ...            # or simply: htpasswd -Bc deploy/nginx/htpasswd user
  #
  # mount it into the nginx service, and uncomment these two lines. Placed at
  # server level they cover everything — including /ws and /aster-stream.
  #
  # auth_basic           "RDO ONE beta";
  # auth_basic_user_file /etc/nginx/htpasswd;

  # ── Security headers ─────────────────────────────────────────────────────
  # `always` so they are still sent on error responses, where they otherwise
  # would not be.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options    "nosniff" always;
  add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options           "SAMEORIGIN" always;

  # CSP ships REPORT-ONLY on purpose. A wallet dapp is close to the worst case
  # for CSP: injected providers (MetaMask, Rabby, Phantom) inject scripts into
  # the page, WalletConnect opens its own sockets, and Next needs
  # 'unsafe-inline' for hydration. Enforcing a policy that has not been checked
  # against a real wallet connect flow would break signing for users with no
  # visible cause. Watch the reports, tighten, and only then switch the header
  # name to Content-Security-Policy.
  add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self' https:; base-uri 'self'; form-action 'self'" always;

  # Aster withdrawal/deposit payloads are small; this is an abuse ceiling.
  client_max_body_size 2m;

  # Renewals keep working without a config change.
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
  }

  # ── Shared proxy headers ─────────────────────────────────────────────────
  # X-Forwarded-For is set to $remote_addr, NOT $proxy_add_x_forwarded_for,
  # and that is a security decision rather than a style one.
  #
  # The backend runs Fastify with trustProxy: true, which trusts the whole
  # forwarded chain and takes its LEFTMOST entry as req.ip. The conventional
  # $proxy_add_x_forwarded_for APPENDS the real peer to whatever the client
  # already sent — so a request arriving with "X-Forwarded-For: 1.2.3.4" ends
  # up as "1.2.3.4, <real ip>" and the backend believes 1.2.3.4. The rate
  # limiter keys on req.ip, so anyone could rotate that header and never be
  # limited, and the per-IP WebSocket cap would be equally meaningless.
  # Overwriting discards the client's claim and forwards only what nginx
  # actually observed.
  #
  # If a CDN or another proxy is ever put in front of this box, this line must
  # change — at that point $remote_addr is the CDN, and the real client IP has
  # to be recovered from the CDN's own header via the realip module.
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_http_version 1.1;

  # ── WebSocket relays ─────────────────────────────────────────────────────
  # Exact-match locations because ws/relay.ts dispatches on an exact pathname.
  #
  # The long read timeout is what keeps these alive: nginx's default
  # proxy_read_timeout is 60s and it applies BETWEEN READS, so any quiet
  # market — no trades, no book change — silently drops every connected user's
  # stream after a minute. The chart just stops.
  location = /ws {
    proxy_pass http://rdo_backend;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout  86400s;
    proxy_send_timeout  86400s;
    proxy_buffering     off;
  }

  location = /aster-stream {
    proxy_pass http://rdo_backend;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout  86400s;
    proxy_send_timeout  86400s;
    proxy_buffering     off;
  }

  # ── Backend HTTP ─────────────────────────────────────────────────────────
  # Only /api/* and /health are routed here directly.
  #
  # The browser ALSO calls bare paths — /aster-signed/*, /aster-withdraw,
  # /lifi-api/*, /news and friends — which are NOT listed here on purpose.
  # next.config.js already rewrites every one of them to the backend, and Next
  # owns that mapping. Duplicating it in nginx would create a second copy that
  # silently rots out of sync the next time a route is added there.
  location = /health {
    proxy_pass http://rdo_backend;
    access_log off;
  }

  location /api/ {
    proxy_pass http://rdo_backend;
    proxy_read_timeout 60s;
  }

  # ── Everything else → Next ───────────────────────────────────────────────
  location / {
    proxy_pass http://rdo_frontend;
    proxy_read_timeout 60s;
  }

  # Immutable hashed build assets. Next already sets a long Cache-Control on
  # these, so this block exists only to keep them off the generic timeout path.
  #
  # NOTE the repeated security headers: nginx's add_header does NOT merge with
  # outer levels — a location that declares even one add_header of its own
  # drops every add_header inherited from server{}. Without these repeats this
  # path would serve the JS bundles with no HSTS and no nosniff.
  location /_next/static/ {
    proxy_pass http://rdo_frontend;
    proxy_read_timeout 60s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Cache-Control             "public, max-age=31536000, immutable";
  }
}
